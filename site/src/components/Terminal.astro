---
interface Line { prompt?: boolean; text: string }
interface Props { lines: Line[]; animate?: boolean; title?: string }
const { lines, animate = false, title } = Astro.props;

function cls(l: Line): string {
  if (l.prompt) return "ln prompt";
  const t = l.text.trim();
  if (t.startsWith("✓")) return "ln ok";
  if (t.startsWith("→")) return "ln call";
  if (t.startsWith("#")) return "ln comment";
  return "ln";
}
---
<div class={`term ${animate ? "anim" : ""}`} data-term>
  <div class="bar">
    <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
    {title && <span class="title mono">{title}</span>}
  </div>
  <pre class="body" aria-label={title ?? "terminal session"}>{lines.map((l, i) => (
    <div class={cls(l)} style={`--i:${i}`}>{l.prompt ? <span class="sigil" aria-hidden="true">›</span> : null}<span class="txt">{l.text}</span></div>
  ))}</pre>
</div>

<style>
  .term {
    background: var(--bg-sunken);
    border: 1px solid var(--border-strong); border-radius: 10px; overflow: hidden;
    box-shadow: 0 24px 60px -34px rgba(0,0,0,.9);
    position: relative;
  }
  .bar {
    display: flex; align-items: center; gap: 7px; padding: 11px 14px;
    border-bottom: 1px solid var(--border); background: rgba(255,255,255,.02);
  }
  .dot { width: 9px; height: 9px; border-radius: 50%; opacity: .8; }
  .dot.r { background: #d9584f; } .dot.y { background: #d8a530; } .dot.g { background: #3f9e50; }
  .title { margin-left: 8px; font-size: 11.5px; color: var(--text-mute); }
  .body { margin: 0; padding: 18px 18px 20px; font-family: var(--font-mono); font-size: 13px; line-height: 1.9; overflow-x: auto; }
  .ln { white-space: pre-wrap; word-break: break-word; color: #B9C5D0; }
  .ln.prompt { color: var(--text); font-weight: 500; }
  .ln.call { color: var(--brand-ink); }
  .ln.ok { color: #6FB98A; }
  .ln.comment { color: var(--text-mute); }
  .sigil { color: var(--text-mute); margin-right: 8px; }

  .anim .ln { opacity: 0; transform: translateY(4px); }
  .anim.run .ln { animation: rise .35s ease forwards; animation-delay: calc(var(--i) * 0.36s + 0.1s); }
  @keyframes rise { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .anim .ln { opacity: 1 !important; transform: none !important; animation: none !important; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.querySelectorAll(".term.anim").forEach((el) => {
    if (reduce) { el.classList.add("run"); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { el.classList.add("run"); io.disconnect(); }
      });
    }, { threshold: 0.35 });
    io.observe(el);
  });
</script>
