---
const caps = [
  "Dry-run previews", "Idempotent writes", "Config snapshots", "One-call rollback",
  "Confirmation tokens", "Per-router circuit breakers", "RBAC identities", "Audit logging",
];
const check = '<path d="M20 6 9 17l-5-5"/>';
---
<section class="section safety">
  <div class="container inner">
    <div class="left" data-reveal>
      <h2 class="h2">Built to touch production safely</h2>
      <p class="lede">Every write passes through layered guardrails before it reaches the router.</p>
      <ul class="caps">
        {caps.map((c) => (
          <li>
            <span class="chk" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={check} /></span>
            {c}
          </li>
        ))}
      </ul>
    </div>
    <figure class="shot" data-reveal>
      <img src="/assets/claude-review.png" alt="Claude reviewing a MikroTik router configuration through MikroMCP before applying a change" loading="lazy" />
      <figcaption class="mono">Claude reviewing a router config before applying changes</figcaption>
    </figure>
  </div>
</section>

<style>
  .inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: 52px; align-items: center; }
  .left .lede { margin: 18px 0 26px; }
  .caps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 14px 24px; }
  .caps li { display: flex; align-items: center; gap: 11px; font-size: 14.5px; color: var(--text); }
  .chk {
    display: inline-flex; align-items: center; justify-content: center; flex: 0 0 auto;
    width: 20px; height: 20px; color: var(--brand-ink);
  }
  .chk svg { width: 15px; height: 15px; }

  .shot { margin: 0; position: relative; }
  .shot img {
    width: 100%; display: block; border-radius: 10px; border: 1px solid var(--border-strong);
    box-shadow: 0 24px 60px -34px rgba(0,0,0,.9);
  }
  figcaption { margin-top: 12px; font-size: 11.5px; color: var(--text-mute); text-align: center; }

  @media (max-width: 880px) {
    .inner { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 480px) { .caps { grid-template-columns: 1fr; } }
</style>
