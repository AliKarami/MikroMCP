---
const steps = [
  { n: "1", t: "Connect your MCP client", b: "Register MikroMCP in Claude Desktop, Claude Code, Cursor, or Codex over stdio or HTTP." },
  { n: "2", t: "Ask in natural language", b: "Describe what you want — inspect a router, audit firewall rules, plan a change. No RouterOS syntax required." },
  { n: "3", t: "MikroMCP validates, audits, and executes", b: "Each call is schema-checked, authorized, logged, and run through a per-router circuit breaker against the RouterOS REST API." },
];
const pipeline = ["Prompt", "Schema validation", "RBAC", "Audit log", "Circuit breaker", "RouterOS REST"];
---
<section class="section how" id="how">
  <div class="container">
    <h2 class="h2 head" data-reveal>From prompt to router in three steps</h2>

    <div class="steps">
      {steps.map((s) => (
        <div class="step" data-reveal>
          <span class="num mono">{s.n.padStart(2, "0")}</span>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>

    <div class="pipe" data-reveal aria-label="Request pipeline">
      {pipeline.map((p, i) => (
        <>
          <span class="chip mono">{p}</span>
          {i < pipeline.length - 1 && <span class="arrow mono" aria-hidden="true">→</span>}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .head { max-width: 560px; margin-bottom: 40px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .step { position: relative; padding-top: 18px; border-top: 1px solid var(--border-strong); }
  .num {
    display: block; font-size: 12px; font-weight: 500; letter-spacing: .08em;
    color: var(--brand-ink); margin-bottom: 12px;
  }
  .step h3 { font-size: 16px; margin-bottom: 8px; }
  .step p { margin: 0; color: var(--text-dim); font-size: 14px; line-height: 1.65; }

  .pipe {
    display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 40px;
    padding: 20px; border-radius: var(--radius);
    border: 1px solid var(--border); background: var(--bg-elev);
    justify-content: center;
  }
  .chip {
    font-size: 12px; padding: 7px 12px; border-radius: 6px; color: var(--text-dim);
    background: var(--bg); border: 1px solid var(--border); white-space: nowrap;
  }
  .chip:last-of-type { border-color: var(--border-strong); color: var(--brand-ink); }
  .arrow { color: var(--text-mute); }

  @media (max-width: 820px) { .steps { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .pipe { flex-direction: column; align-items: stretch; }
    .chip { text-align: center; }
    .arrow { transform: rotate(90deg); text-align: center; }
  }
</style>
