---
import Shapes from "./Shapes.astro";

const steps = [
  { n: "1", t: "Connect your MCP client", b: "Register MikroMCP in Claude Desktop, Claude Code, Cursor, or Codex over stdio or HTTP." },
  { n: "2", t: "Ask in natural language", b: "Describe what you want — inspect a router, audit firewall rules, plan a change. No RouterOS syntax required." },
  { n: "3", t: "MikroMCP validates, audits, and executes", b: "Each call is schema-checked, authorized, logged, and run through a per-router circuit breaker against the RouterOS REST API." },
];
const pipeline = ["Prompt", "Schema validation", "RBAC", "Audit log", "Circuit breaker", "RouterOS REST"];
---
<section class="section how" id="how">
  <div class="container">
    <p class="eyebrow" data-reveal>How it works</p>
    <h2 class="h2 head" data-reveal>From prompt to router in three steps</h2>

    <div class="steps">
      {steps.map((s) => (
        <div class="step" data-reveal>
          <span class="num grad-text mono">{s.n.padStart(2, "0")}</span>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>

    <div class="panel-field pipe-wrap" data-reveal>
      <div class="arc" aria-hidden="true"><Shapes name="pipe" /></div>
      <div class="pipe" aria-label="Request pipeline">
        {pipeline.map((p, i) => (
          <>
            <span class="chip mono">{p}</span>
            {i < pipeline.length - 1 && <span class="arrow mono" aria-hidden="true">→</span>}
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .head { max-width: 580px; margin: 14px 0 44px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px; }
  .step { position: relative; padding-top: 22px; }
  .step::before {
    content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px; border-radius: 2px;
    background: var(--grad-brand); opacity: .85;
  }
  .num { display: block; font-size: 28px; font-weight: 500; line-height: 1; margin-bottom: 14px; }
  .step h3 { font-size: 17px; margin-bottom: 9px; }
  .step p { margin: 0; color: var(--text-dim); font-size: 14px; line-height: 1.65; }

  .pipe-wrap { margin-top: 46px; padding: 30px 26px; }
  .arc { position: absolute; left: -70px; bottom: -120px; width: 320px; opacity: .32; pointer-events: none; }
  .pipe {
    position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 9px;
    justify-content: center;
  }
  .chip {
    font-size: 12.5px; padding: 9px 15px; border-radius: 999px; color: var(--text);
    background: rgba(255,255,255,.05); border: 1px solid var(--border-strong); white-space: nowrap;
    transition: border-color .18s ease, background .18s ease;
  }
  .chip:hover { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.34); }
  .chip:first-of-type { border-color: rgba(45,212,191,.5); color: var(--c1); }
  .chip:last-of-type { border-color: rgba(139,92,246,.55); color: #B79BFB; }
  .arrow { color: var(--text-mute); }

  @media (max-width: 820px) { .steps { grid-template-columns: 1fr; gap: 26px; } }
  @media (max-width: 520px) {
    .pipe { flex-direction: column; align-items: stretch; }
    .chip { text-align: center; }
    .arrow { transform: rotate(90deg); text-align: center; }
    .arc { display: none; }
  }
</style>
