---
const steps = [
  { n: "1", t: "Connect your MCP client", b: "Register MikroMCP in Claude Desktop, Claude Code, Cursor, or Codex over stdio or HTTP." },
  { n: "2", t: "Ask in natural language", b: "Describe what you want — inspect a router, audit firewall rules, plan a change. No RouterOS syntax required." },
  { n: "3", t: "MikroMCP validates, audits, and executes", b: "Each call is schema-checked, authorized, logged, and run through a per-router circuit breaker against the RouterOS REST API." },
];
const pipeline = ["Prompt", "Schema validation", "RBAC", "Audit log", "Circuit breaker", "RouterOS REST"];
---
<section class="section how" id="how">
  <div class="container">
    <h2 class="h2 head" data-reveal>From prompt to router in three steps</h2>

    <div class="steps">
      {steps.map((s) => (
        <div class="step" data-reveal>
          <span class="num mono">{s.n}</span>
          <h3>{s.t}</h3>
          <p>{s.b}</p>
        </div>
      ))}
    </div>

    <div class="pipe" data-reveal aria-label="Request pipeline">
      {pipeline.map((p, i) => (
        <>
          <span class="chip mono">{p}</span>
          {i < pipeline.length - 1 && <span class="arrow mono" aria-hidden="true">→</span>}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .head { max-width: 560px; margin-bottom: 44px; }
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .step {
    position: relative; padding: 28px 24px; border-radius: var(--radius);
    background: var(--bg-elev); border: 1px solid var(--border);
  }
  .num {
    display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px;
    border-radius: 9px; font-size: 16px; font-weight: 500; color: #04110F;
    background: linear-gradient(135deg, var(--brand-glow), var(--brand)); margin-bottom: 16px;
    box-shadow: 0 6px 18px -6px rgba(20,184,166,.7);
  }
  .step h3 { font-size: 16.5px; margin-bottom: 8px; }
  .step p { margin: 0; color: var(--text-dim); font-size: 14px; line-height: 1.6; }

  .pipe {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 40px;
    padding: 22px; border-radius: var(--radius);
    border: 1px solid var(--border); background: rgba(20,184,166,.03);
    justify-content: center;
  }
  .chip {
    font-size: 12.5px; padding: 8px 14px; border-radius: 999px; color: var(--text);
    background: #0E1318; border: 1px solid var(--border); white-space: nowrap;
  }
  .chip:first-of-type { border-color: rgba(234,88,12,.4); color: #ffb389; }
  .chip:last-of-type { border-color: var(--brand); color: var(--brand-glow); }
  .arrow { color: var(--brand); font-weight: 700; }

  @media (max-width: 820px) { .steps { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .pipe { flex-direction: column; align-items: stretch; }
    .chip { text-align: center; }
    .arrow { transform: rotate(90deg); text-align: center; }
  }
</style>
