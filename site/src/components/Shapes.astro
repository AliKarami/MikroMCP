---
/**
 * Geometric motifs built from the brand ramp (--c1 teal → --c4 violet).
 * Inline SVG rather than image assets so they stay crisp and pick up the theme
 * tokens. Each figure is decorative — callers keep them aria-hidden.
 *
 *  fan     — stacked rounded squares pivoting from one corner. Reads as a fleet of
 *            routers under one control plane; the hero figure.
 *  mesh    — node/edge network graph, used as a low-contrast field texture.
 *  pipe    — concentric arcs radiating from a single node, for the request pipeline.
 */
import { nextId } from "../lib/uid.ts";

interface Props { name: "fan" | "mesh" | "pipe" }
const { name } = Astro.props;

const uid = nextId("s");
const fanCards = [
  { a: 0, o: 1, from: "#2DD4BF", to: "#22A7E0" },
  { a: -13, o: 0.95, from: "#22A7E0", to: "#3D8AEE" },
  { a: -26, o: 0.9, from: "#3D8AEE", to: "#4F6BF6" },
  { a: -39, o: 0.85, from: "#4F6BF6", to: "#6E5DF8" },
  { a: -52, o: 0.8, from: "#6E5DF8", to: "#8B5CF6" },
];

const meshNodes = [
  [40, 150], [130, 60], [130, 210], [240, 110], [240, 240], [350, 55], [350, 185], [440, 130],
];
const meshEdges = [
  [0, 1], [0, 2], [1, 3], [2, 3], [2, 4], [3, 5], [3, 6], [4, 6], [5, 7], [6, 7],
];
---
{name === "fan" && (
  <svg class="shape-svg" viewBox="0 0 520 460" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      {fanCards.map((c, i) => (
        <linearGradient id={`fan-${uid}-${i}`} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color={c.from} />
          <stop offset="100%" stop-color={c.to} />
        </linearGradient>
      ))}
      <filter id={`fanblur-${uid}`} x="-40%" y="-40%" width="180%" height="180%">
        <feGaussianBlur stdDeviation="34" />
      </filter>
    </defs>

    <ellipse cx="270" cy="250" rx="170" ry="150" fill="#4F6BF6" opacity=".30" filter={`url(#fanblur-${uid})`} />

    {[...fanCards].reverse().map((c, ri) => {
      const i = fanCards.length - 1 - ri;
      return (
        <rect
          x="150" y="150" width="200" height="200" rx="46"
          fill={`url(#fan-${uid}-${i})`}
          opacity={c.o}
          transform={`rotate(${c.a} 160 350)`}
        />
      );
    })}

    <rect x="150" y="150" width="200" height="200" rx="46" fill="none" stroke="rgba(255,255,255,.22)" />
    <circle cx="160" cy="350" r="7" fill="#fff" opacity=".9" />
  </svg>
)}

{name === "mesh" && (
  <svg class="shape-svg" viewBox="0 0 480 280" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id={`mesh-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#2DD4BF" />
        <stop offset="38%" stop-color="#22A7E0" />
        <stop offset="70%" stop-color="#4F6BF6" />
        <stop offset="100%" stop-color="#8B5CF6" />
      </linearGradient>
    </defs>
    <g stroke={`url(#mesh-${uid})`} stroke-width="1.25" opacity=".55">
      {meshEdges.map(([a, b]) => (
        <line x1={meshNodes[a][0]} y1={meshNodes[a][1]} x2={meshNodes[b][0]} y2={meshNodes[b][1]} />
      ))}
    </g>
    <g fill={`url(#mesh-${uid})`}>
      {meshNodes.map(([x, y], i) => <circle cx={x} cy={y} r={i % 3 === 0 ? 5.5 : 4} />)}
    </g>
  </svg>
)}

{name === "pipe" && (
  <svg class="shape-svg" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <linearGradient id={`pipe-${uid}`} x1="0" y1="1" x2="1" y2="0">
        <stop offset="0%" stop-color="#2DD4BF" />
        <stop offset="50%" stop-color="#4F6BF6" />
        <stop offset="100%" stop-color="#8B5CF6" />
      </linearGradient>
    </defs>
    <g stroke={`url(#pipe-${uid})`} fill="none" stroke-linecap="round">
      <path d="M30 270 A 90 90 0 0 1 120 180" stroke-width="2.5" opacity=".9" />
      <path d="M30 270 A 140 140 0 0 1 170 130" stroke-width="2.5" opacity=".7" />
      <path d="M30 270 A 190 190 0 0 1 220 80" stroke-width="2.5" opacity=".5" />
      <path d="M30 270 A 240 240 0 0 1 270 30" stroke-width="2.5" opacity=".32" />
    </g>
    <circle cx="30" cy="270" r="8" fill={`url(#pipe-${uid})`} />
  </svg>
)}
