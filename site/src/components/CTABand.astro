---
import { SITE } from "../data/content.ts";
---
<section class="cta">
  <div class="glow" aria-hidden="true"></div>
  <div class="container inner" data-reveal>
    <h2 class="h2">Bring AI to your MikroTik fleet</h2>
    <div class="btns">
      <a class="btn btn-accent btn-lg" href="#quick-start">Get Started</a>
      <a class="btn btn-ghost btn-lg" href={SITE.github} target="_blank" rel="noopener">View on GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: hidden; padding: 88px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); text-align: center; }
  .cta::before {
    content: ""; position: absolute; inset: 0;
    background:
      radial-gradient(60% 120% at 50% 0%, rgba(20,184,166,.16), transparent 60%),
      radial-gradient(rgba(255,255,255,.04) 1px, transparent 1px);
    background-size: auto, 26px 26px;
    mask-image: radial-gradient(80% 100% at 50% 50%, #000, transparent 80%);
    -webkit-mask-image: radial-gradient(80% 100% at 50% 50%, #000, transparent 80%);
  }
  .glow {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    width: 700px; height: 320px; background: radial-gradient(circle, rgba(45,212,191,.18), transparent 65%);
    filter: blur(30px); pointer-events: none;
  }
  .inner { position: relative; }
  .h2 { margin-bottom: 28px; }
  .btns { display: inline-flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
</style>
