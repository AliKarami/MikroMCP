---
import { SITE } from "../data/content.ts";
---
<section class="cta">
  <div class="container inner" data-reveal>
    <h2 class="h2">Bring AI to your MikroTik fleet</h2>
    <p class="lede">Install in a minute, dry-run everything, keep the audit trail.</p>
    <div class="btns">
      <a class="btn btn-primary btn-lg" href="#quick-start">Get Started</a>
      <a class="btn btn-ghost btn-lg" href={SITE.github} target="_blank" rel="noopener">View on GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; padding: 84px 0; border-top: 1px solid var(--border); text-align: center; }
  .inner { position: relative; }
  .h2 { margin-bottom: 12px; }
  .lede { margin: 0 auto 28px; max-width: 460px; }
  .btns { display: inline-flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
</style>
