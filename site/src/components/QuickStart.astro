---
import { SITE } from "../data/content.ts";

const tabs = [
  { id: "npm", label: "npm", lines: ["npm install -g mikromcp", "mikromcp init"] },
  { id: "binary", label: "Binary", lines: ["# Download from GitHub releases, then", "chmod +x mikromcp-linux-x64", "./mikromcp-linux-x64 init"] },
  { id: "docker", label: "Docker", lines: ["docker pull ghcr.io/alikarami/mikromcp:latest"] },
];
---
<section class="section qs" id="quick-start">
  <div class="container split">
    <div class="lead">
      <p class="eyebrow" data-reveal>Install</p>
      <h2 class="h2 head" data-reveal>Up and running in minutes</h2>
      <p class="note" data-reveal>
        <code class="mono">mikromcp init</code> runs a guided wizard, then open your AI assistant and just ask.
      </p>
      <p class="docs" data-reveal>
        <a href={`${SITE.docs}/getting-started/`} target="_blank" rel="noopener">Full Getting Started guide →</a>
      </p>
    </div>

    <div class="tabs" data-reveal>
      <div class="tablist" role="tablist" aria-label="Install methods">
        {tabs.map((t, i) => (
          <button class={`tab mono ${i === 0 ? "active" : ""}`} role="tab" id={`qs-tab-${i}`}
            aria-selected={i === 0 ? "true" : "false"} aria-controls={`qs-panel-${i}`}
            tabindex={i === 0 ? "0" : "-1"} data-i={i}>{t.label}</button>
        ))}
      </div>

      {tabs.map((t, i) => (
        <div class={`panel ${i === 0 ? "active" : ""}`} role="tabpanel" id={`qs-panel-${i}`}
          aria-labelledby={`qs-tab-${i}`} hidden={i !== 0}>
          <div class="code">
            <button class="copy mono" data-copy={t.lines.join("\n")} aria-label={`Copy ${t.label} install command`}>Copy</button>
            <pre class="mono">{t.lines.map((l, j) => (
              <div class={l.startsWith("#") ? "cl comment" : "cl"}>{!l.startsWith("#") && <span class="p" aria-hidden="true">$</span>}<span>{l}</span></div>
            ))}</pre>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .qs { position: relative; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); overflow: hidden;
    background:
      radial-gradient(70% 120% at 8% 0%, rgba(45,212,191,.13), transparent 58%),
      radial-gradient(70% 120% at 92% 100%, rgba(139,92,246,.18), transparent 58%),
      var(--bg-elev); }
  .qs > .container { position: relative; }
  .head { margin: 14px 0 22px; }
  .split { display: grid; grid-template-columns: 0.85fr 1fr; gap: 56px; align-items: center; }
  .lead { max-width: 420px; }
  .tabs { min-width: 0; }
  .tablist { display: flex; gap: 8px; overflow-x: auto; margin-bottom: 16px; padding-bottom: 4px; }
  .tab {
    flex: 0 0 auto; font-size: 12.5px; padding: 9px 18px; border-radius: 999px; cursor: pointer;
    background: transparent; border: 1px solid var(--border-strong); color: var(--text-dim);
    transition: color .15s ease, border-color .15s ease, background .15s ease; white-space: nowrap;
  }
  .tab:hover { color: var(--text); border-color: #3B4551; }
  .tab.active { color: #fff; background: var(--grad-brand); border-color: transparent; font-weight: 600; }
  .tab:focus-visible { outline: 2px solid var(--c2); outline-offset: 2px; }

  .panel { display: none; } .panel.active { display: block; }
  .code { position: relative; background: linear-gradient(180deg,#0C1120,#070A12); border: 1px solid var(--border-strong); border-radius: 16px; overflow: hidden; }
  .code pre { margin: 0; padding: 20px 22px; font-size: 13px; line-height: 1.95; overflow-x: auto; }
  .cl { color: #C3CFDA; white-space: pre; }
  .cl.comment { color: var(--text-mute); }
  .p { color: var(--text-mute); margin-right: 10px; }
  .copy {
    position: absolute; top: 10px; right: 10px; z-index: 2; font-size: 11.5px; padding: 6px 11px;
    border-radius: 6px; cursor: pointer; background: rgba(255,255,255,.04);
    border: 1px solid var(--border-strong); color: var(--text-dim); transition: color .15s ease, border-color .15s ease;
  }
  .copy:hover { color: var(--text); border-color: #3B4551; }
  .copy.done { color: var(--c1); border-color: rgba(45,212,191,.45); }
  .copy:focus-visible { outline: 2px solid var(--c2); outline-offset: 2px; }

  .note { margin: 0 0 12px; color: var(--text-dim); font-size: 14.5px; }
  .note code { color: var(--c1); background: rgba(45,212,191,.1); border: 1px solid rgba(45,212,191,.24); padding: 2px 8px; border-radius: 6px; font-size: 12.5px; }
  .docs a { color: #7FD5E8; font-weight: 500; font-size: 14px; }
  .docs a:hover { text-decoration: underline; }
  .docs a:focus-visible { outline: 2px solid var(--c2); outline-offset: 3px; border-radius: 4px; }

  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; gap: 32px; }
    .lead { max-width: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".qs .tabs").forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".panel"));
    const select = (i: number) => {
      tabs.forEach((t, j) => {
        const on = j === i;
        t.classList.toggle("active", on);
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p, j) => { p.classList.toggle("active", j === i); p.hidden = j !== i; });
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      t.addEventListener("keydown", (e) => {
        if (e.key === "ArrowRight" || e.key === "ArrowLeft") {
          e.preventDefault();
          const n = (i + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length;
          select(n); tabs[n].focus();
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>(".qs .copy").forEach((btn) => {
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? "");
        const prev = btn.textContent;
        btn.textContent = "Copied"; btn.classList.add("done");
        setTimeout(() => { btn.textContent = prev; btn.classList.remove("done"); }, 1500);
      } catch {}
    });
  });
</script>
